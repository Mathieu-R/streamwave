{
	"name": "streamwave",
	"version": "1.0.0",
	"private": true,
	"packageManager": "pnpm@11.27.0",
	"scripts": {
		"build": "turbo run build --filter=@streamwave/app",
		"env:ensure": "node scripts/ensure-env.mjs",
		"predev": "pnpm run env:ensure",
		"dev": "docker compose up -d --wait && turbo run dev --filter=@streamwave/app --filter=@streamwave/api --filter=@streamwave/ui-kit",
		"typecheck": "turbo run typecheck --concurrency=2",
		"typecheck:changed": "turbo run typecheck --filter=\"...[origin/main]\" --concurrency=2",
		"lint:check": "oxlint --disable-nested-config --type-aware -f default .",
		"lint:fix": "oxlint --disable-nested-config --type-aware -f default --fix .",
		"format:check": "oxfmt --check .",
		"format:fix": "oxfmt .",
		"lint:format:check": "pnpm run lint:check && pnpm run format:check",
		"lint:format:fix": "pnpm run lint:fix && pnpm run format:fix",
		"lint:format:ci": "pnpm run lint:check && pnpm run format:check && pnpm run typecheck",
		"translate": "turbo run translate --filter=@streamwave/translations",
		"test": "vitest",
		"test:ci": "vitest run"
	},
	"license": "MIT",
	"devDependencies": {
		"@streamwave/oxlint": "workspace:*",
		"@types/node": "^26.2.0",
		"oxfmt": "^0.64.0",
		"oxlint": "^1.79.0",
		"oxlint-tsgolint": "^7.0.2002",
		"turbo": "^2.10.11",
		"typescript": "7.0.2",
		"vitest": "^4.1.11"
	}
}
