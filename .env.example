# Mail relay (docker-compose mailserver)
SMTP=smtp://localhost:2025

# Inngest (local development)
INNGEST_DEV=1

# Needed when launching turbo scripts with concurrently
TURBO_UI=true

# PostgreSQL (DATABASE_URL is derived in @streamwave/drizzle)
POSTGRES_HOST=localhost
POSTGRES_USER=streamwave
POSTGRES_PASSWORD=streamwave
POSTGRES_DB=streamwave_dev
POSTGRES_PORT=5432

# Optional database seed (uses @streamwave/cdn data by default)
SEED_DATABASE=false
# STREAMWAVE_MEDIA_DIR=/absolute/path/to/media/data
